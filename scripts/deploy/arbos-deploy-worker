#!/usr/bin/env bash
# arbos-deploy-worker — continuous delivery of the server parts, on the relay host, as root.
#
#   arbos-deploy-worker tick                  one pass (the `arbos-deploy.timer` runs it every minute)
#   arbos-deploy-worker roll-image <sha>      build + register + roll the sandbox image for a commit
#   arbos-deploy-worker roll-continue         one more roll pass for boxes still pending (15-min cadence)
#   arbos-deploy-worker status                what is deployed, queued, running, failed
#
# A tick:
#   1. fetches origin/main and, for every part whose deployed commit differs from main in the
#      paths it is built from, queues a request for main's head (so a merge is deployed even when
#      nobody called the hook);
#   2. reads the queue written by `arbos-deploy-hook` (the poller's call after a gated merge);
#   3. deploys every request that has settled — SETTLE_S of quiet after the last request, or
#      MAX_WAIT_S after the first — whose commit is on main and whose CI run is green:
#        relay   scripts/feedback/deploy-relay.sh <sha> of that commit (builds from source, keeps
#                the env, never rolls back), then /healthz; writes /etc/arbos/relay.deployed-sha
#        voice   scripts/deploy/voice-server.sh from a checkout of that commit; writes
#                /etc/arbos/voice.deployed-sha
#        agentd  `roll-image` in its own transient unit (arbos-deploy-agentd), because it takes
#                15–40 minutes: tag image-v0.1.N, wait for the `image` workflow's build + smoke,
#                prune Daytona snapshots (quota 30), register the snapshot, switch the relay
#                default, restart the relay, roll every real box at a quiet moment
#                (docs/memory-tree-production.md §8b); writes <state>/agentd.deployed-sha.
#   A failed deploy is logged as a `deploy_failed` line in /var/lib/arbos-feedback/deploy-events.jsonl
#   (the feedback loop surfaces it in its audits), retried once after 10 minutes, then left for the
#   next commit. A roll whose window closes with boxes still pending keeps retrying every 15 minutes;
#   agentd.deployed-sha is written only when the relay's `agentd.real_min_sha` is that commit.
#
# Files: /var/lib/arbos-deploy/{repo,log,failed/,runs/,agentd.deployed-sha};
# knobs in /etc/arbos/deploy.env (AUTO_DEPLOY_RELAY/AGENTD/VOICE=0|1, SETTLE_S, MAX_WAIT_S);
# kill switch /etc/arbos/deploy.disabled. Secrets are read from /etc/arbos/feedback.env
# (GITHUB_TOKEN) and /etc/arbos/relay.env (DAYTONA_API_KEY, ARBOS_RELAY_ADMIN_TOKEN); none is
# printed. The feedback loop judges "live" from the deployed shas, not from this script.
set -euo pipefail

STATE="${ARBOS_DEPLOY_STATE:-/var/lib/arbos-deploy}"
QUEUE="${ARBOS_DEPLOY_QUEUE:-/var/lib/arbos-feedback/deploy-requests}"
REPO_URL="https://github.com/unarbos/arbos.git"
GH_REPO="unarbos/arbos"
API="https://api.github.com/repos/$GH_REPO"
RELAY_URL="${ARBOS_RELAY_URL:-http://127.0.0.1:7700}"
RELAY_ENV=/etc/arbos/relay.env
FEEDBACK_ENV=/etc/arbos/feedback.env
DEPLOY_ENV=/etc/arbos/deploy.env
KILL_FILE=/etc/arbos/deploy.disabled
HOOK="${ARBOS_DEPLOY_HOOK:-/usr/local/bin/arbos-deploy-hook}"
SETTLE_S=120
MAX_WAIT_S=300
AUTO_DEPLOY_RELAY=1
AUTO_DEPLOY_AGENTD=1
AUTO_DEPLOY_VOICE=1
CI_NONE_GRACE_S=900
IMAGE_WAIT_S=2700
ROLL_WAIT_S=5400
RETRY_AFTER_S=600
ROLL_RETRY_EVERY_S=900
EVENTS="${ARBOS_DEPLOY_EVENTS:-/var/lib/arbos-feedback/deploy-events.jsonl}"
BUILD_USER="${BUILD_USER:-const}"
# shellcheck disable=SC1090
[[ -f "$DEPLOY_ENV" ]] && . "$DEPLOY_ENV"

REPO="$STATE/repo"
LOG="$STATE/log"
# Under systemd there is no HOME and no SUDO_UID: git would call the build user's clone
# (/home/const/arbos-build/repo, used by deploy-relay.sh) "dubious ownership" and fail to
# read its HEAD. Trust the checkouts this host deploys from.
export HOME="${HOME:-/root}"
export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=safe.directory GIT_CONFIG_VALUE_0='*'

log() {
  local line
  line="$(date -u +%Y-%m-%dT%H:%M:%SZ) $*"
  echo "$line"
  echo "$line" >> "$LOG" 2>/dev/null || true
}

need_root() { [[ $EUID -eq 0 ]] || { echo "run as root" >&2; exit 1; }; }

secret_from() {
  # secret_from <file> <KEY> — the value of KEY=… in an env file, never echoed by callers.
  sed -n "s/^$2=//p" "$1" | head -1 | tr -d '"' | tr -d "'"
}

gh_token() { secret_from "$FEEDBACK_ENV" GITHUB_TOKEN; }

event() {
  # event <kind> <sha> <event-name> <detail…> — one JSON line the feedback loop reads for its audits.
  local kind="$1" sha="$2" name="$3"; shift 3
  python3 - "$EVENTS" "$kind" "$sha" "$name" "$*" <<'EOF2' 2>/dev/null || true
import json, sys, time
path, kind, sha, name, detail = sys.argv[1:6]
line = json.dumps({"at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "event": name,
                   "deploy": kind, "sha": sha, "detail": detail[:600]})
with open(path, "a") as f:
    f.write(line + "\n")
EOF2
  chmod 0644 "$EVENTS" 2>/dev/null || true
}

failed_marker() { echo "$STATE/failed/$1-$2"; }
failed_attempts() { sed -n 's/^attempts=//p' "$(failed_marker "$1" "$2")" 2>/dev/null | head -1 || true; }
failed_at() { sed -n 's/^at=//p' "$(failed_marker "$1" "$2")" 2>/dev/null | head -1 || true; }

record_failure() {
  # record_failure <kind> <sha> <reason> — remember it, tell the loop; the caller decides on retry.
  local kind="$1" sha="$2" reason="$3" n
  n="$(failed_attempts "$kind" "$sha")"; n="${n:-0}"
  printf 'attempts=%s\nat=%s\nreason=%s\n' "$((n + 1))" "$(date -u +%s)" "$reason" > "$(failed_marker "$kind" "$sha")"
  event "$kind" "$sha" deploy_failed "attempt $((n + 1)): $reason"
  log "$kind: deploy of $sha FAILED (attempt $((n + 1))) — $reason"
}

gh_api() {
  # gh_api <path-after-repo> [curl args…]
  local path="$1"; shift
  curl -fsS --max-time 60 -H "Authorization: Bearer $(gh_token)" -H "Accept: application/vnd.github+json" \
    "$API$path" "$@"
}

ensure_repo() {
  mkdir -p "$STATE/failed" "$STATE/runs"
  if [[ ! -d "$REPO/.git" ]]; then
    git clone -q "$REPO_URL" "$REPO"
  fi
  git -C "$REPO" fetch -q --tags --force origin "+refs/heads/main:refs/remotes/origin/main"
}

resolve() {
  git -C "$REPO" rev-parse -q --verify "$1^{commit}" 2>/dev/null
}

on_main() {
  git -C "$REPO" merge-base --is-ancestor "$1" origin/main 2>/dev/null
}

deployed_sha() {
  case "$1" in
    relay) cat /etc/arbos/relay.deployed-sha 2>/dev/null || true ;;
    voice) cat /etc/arbos/voice.deployed-sha 2>/dev/null || true ;;
    agentd) cat "$STATE/agentd.deployed-sha" 2>/dev/null || true ;;
  esac
}

paths_of() {
  case "$1" in
    relay) echo "crates/arbos-relay crates/arbos-core crates/arbosctl scripts/deploy/relay-server.sh scripts/deploy/Caddyfile" ;;
    voice) echo "voice" ;;
    agentd) echo "crates/arbos-agentd image harness" ;;
  esac
}

# ci_state <sha> → success | pending | failed | none
ci_state() {
  local runs
  runs="$(gh_api "/actions/workflows/ci.yml/runs?head_sha=$1&per_page=5" 2>/dev/null || true)"
  [[ -n "$runs" ]] || { echo none; return; }
  python3 - "$runs" <<'EOF'
import json, sys
runs = json.loads(sys.argv[1]).get("workflow_runs", [])
runs = [r for r in runs if r.get("event") == "push"] or runs
if not runs:
    print("none"); sys.exit()
r = sorted(runs, key=lambda r: r.get("run_number", 0))[-1]
if r.get("status") != "completed":
    print("pending")
elif r.get("conclusion") == "success":
    print("success")
else:
    print("failed")
EOF
}

commit_age_s() {
  local at
  at="$(git -C "$REPO" show -s --format=%ct "$1" 2>/dev/null || echo 0)"
  echo $(( $(date -u +%s) - at ))
}

# ---------------------------------------------------------------------------------------------
# relay / voice
# ---------------------------------------------------------------------------------------------

deploy_relay() {
  local sha="$1" tmp t0
  tmp="$(mktemp -d)"
  git -C "$REPO" show "$sha:scripts/feedback/deploy-relay.sh" > "$tmp/deploy-relay.sh"
  t0=$(date +%s)
  log "relay: deploying $sha (build from source as $BUILD_USER)"
  if BUILD_USER="$BUILD_USER" bash "$tmp/deploy-relay.sh" "$sha" > "$STATE/runs/relay-$sha.log" 2>&1; then
    rm -rf "$tmp"
    local now
    now="$(deployed_sha relay)"
    if [[ "$now" != "$sha" ]]; then
      record_failure relay "$sha" "deploy script finished but relay.deployed-sha is $now"
      return 1
    fi
    sleep 3
    if curl -fsS --max-time 10 "$RELAY_URL/healthz" >/dev/null; then
      log "relay: live on $sha after $(( $(date +%s) - t0 )) s"
      event relay "$sha" deployed "live after $(( $(date +%s) - t0 )) s"
      return 0
    fi
    record_failure relay "$sha" "deployed but /healthz does not answer"
    return 1
  fi
  rm -rf "$tmp"
  record_failure relay "$sha" "after $(( $(date +%s) - t0 )) s: $(tail -3 "$STATE/runs/relay-$sha.log" | tr '\n' ' ')"
  return 1
}

deploy_voice() {
  local sha="$1" t0
  t0=$(date +%s)
  log "voice: deploying $sha"
  git -C "$REPO" checkout -q --detach "$sha"
  if bash "$REPO/scripts/deploy/voice-server.sh" > "$STATE/runs/voice-$sha.log" 2>&1; then
    log "voice: live on $(deployed_sha voice) after $(( $(date +%s) - t0 )) s"
    event voice "$sha" deployed "live after $(( $(date +%s) - t0 )) s"
    return 0
  fi
  record_failure voice "$sha" "$(tail -3 "$STATE/runs/voice-$sha.log" | tr '\n' ' ')"
  return 1
}

# ---------------------------------------------------------------------------------------------
# agentd: image build (GitHub Actions) + Daytona snapshot + roll (§8b)
# ---------------------------------------------------------------------------------------------

next_image_version() {
  # image-v0.1.N tags → 0.1.(N+1); a tag already at this sha is reused.
  local sha="$1" tag at max=0 n
  while read -r tag; do
    [[ -n "$tag" ]] || continue
    at="$(resolve "$tag")"
    if [[ "$at" == "$sha" ]]; then
      echo "${tag#image-v}"
      return
    fi
    n="${tag##*.}"
    [[ "$n" =~ ^[0-9]+$ ]] && (( n > max )) && max=$n
  done < <(git -C "$REPO" tag -l 'image-v0.1.*')
  echo "0.1.$((max + 1))"
}

push_tag() {
  # push_tag <tag> <sha> — with the workflow PAT, never on a command line.
  local tag="$1" sha="$2" askpass
  git -C "$REPO" tag -f "$tag" "$sha"
  askpass="$(mktemp)"
  printf '#!/bin/sh\necho "$ARBOS_GIT_TOKEN"\n' > "$askpass"
  chmod 0700 "$askpass"
  ARBOS_GIT_TOKEN="$(gh_token)" GIT_ASKPASS="$askpass" GIT_TERMINAL_PROMPT=0 \
    git -C "$REPO" push -q "https://x-access-token@github.com/$GH_REPO.git" "refs/tags/$tag"
  rm -f "$askpass"
}

# image_run_state <tag> → ok | pending | failed | none  (the build + smoke steps; the register
# step always fails in CI — no DAYTONA_API_KEY there — and is done here instead)
image_run_state() {
  local runs id jobs
  runs="$(gh_api "/actions/workflows/image.yml/runs?branch=$1&event=push&per_page=3" 2>/dev/null || true)"
  id="$(printf '%s' "$runs" | python3 -c 'import json,sys; r=json.load(sys.stdin).get("workflow_runs",[]); print(r[0]["id"] if r else "")' 2>/dev/null || true)"
  [[ -n "$id" ]] || { echo none; return; }
  jobs="$(gh_api "/actions/runs/$id/jobs" 2>/dev/null || true)"
  printf '%s' "$jobs" | python3 -c '
import json, sys
jobs = json.load(sys.stdin).get("jobs", [])
steps = {s["name"]: s for j in jobs for s in j.get("steps", [])}
want = [n for n in steps if n.startswith("Build and push") or n.startswith("Local smoke")]
if len(want) < 2:
    print("pending" if any(j.get("status") != "completed" for j in jobs) or not jobs else "failed"); sys.exit()
st = [steps[n] for n in want]
if any(s.get("status") != "completed" for s in st):
    print("pending")
elif all(s.get("conclusion") == "success" for s in st):
    print("ok")
else:
    print("failed")
' 2>/dev/null || echo pending
}

relay_db() { sudo -u arbos sqlite3 /var/lib/arbos-relay/relay.db "$@"; }

prune_snapshots() {
  # §8b step 4. keep = relay default + every live box's snapshot + this and the two previous versions.
  local cur="$1" api=https://app.daytona.io/api key def live keep all total count
  key="$(secret_from "$RELAY_ENV" DAYTONA_API_KEY)"
  def="$(secret_from "$RELAY_ENV" ARBOS_DAYTONA_SNAPSHOT)"
  live="$(relay_db "select distinct snapshot from boxes where sandbox_id is not null and snapshot is not null" | tr '\n' ' ')"
  local maj="${cur%.*}" n="${cur##*.}"
  keep="$def arbos-agent-$cur arbos-agent-$maj.$((n-1)) arbos-agent-$maj.$((n-2)) $live"
  log "agentd: snapshot keep list: $(echo "$keep" | tr ' ' '\n' | sort -u | tr '\n' ' ')"
  all="$(curl -fsS -H "Authorization: Bearer $key" "$api/snapshots?limit=200" | python3 -c '
import sys, json
d = json.load(sys.stdin); items = d.get("items", d if isinstance(d, list) else [])
for s in sorted(items, key=lambda x: x.get("createdAt", "")):
    print(s["id"], s["name"], s.get("state"), s.get("createdAt", ""))')"
  total="$(printf '%s\n' "$all" | grep -c . || true)"
  count=$total
  log "agentd: $total Daytona snapshots before pruning"
  local id name st created code
  while read -r id name st created; do
    [[ "$name" == arbos-agent-* ]] || continue
    if echo " $keep " | grep -q " $name "; then continue; fi
    (( count <= 25 )) && break
    code="$(curl -s -o /dev/null -w '%{http_code}' -X DELETE -H "Authorization: Bearer $key" "$api/snapshots/$id")"
    if [[ "$code" =~ ^2 ]]; then
      log "agentd: deleted snapshot $name ($st, $created)"; count=$((count-1))
    else
      log "agentd: skipped snapshot $name (HTTP $code; a hibernated sandbox may still point at it)"
    fi
  done <<< "$all"
  log "agentd: $count Daytona snapshots after pruning"
}

admin_users() {
  curl -fsS --max-time 30 -H "Authorization: Bearer $(secret_from "$RELAY_ENV" ARBOS_RELAY_ADMIN_TOKEN)" "$RELAY_URL/admin/users"
}

pending_boxes() {
  # pending_boxes <target> [real|test|all] — boxes not on the target snapshot and not upgrading.
  # Real users first; test_ boxes follow so they do not drift and `all_same` stays meaningful.
  admin_users | python3 -c '
import sys, json
target, tier = sys.argv[1], sys.argv[2]
for u in json.load(sys.stdin):
    m = u.get("machine") or {}
    is_test = u["id"].startswith("test_")
    if tier == "real" and is_test: continue
    if tier == "test" and not is_test: continue
    if not m.get("sandbox_id"):
        continue
    if m.get("snapshot") != target and not (m.get("upgrade") or {}).get("in_progress"):
        print(u["id"])' "$1" "${2:-all}"
}

real_min_sha() {
  curl -fsS --max-time 30 -H "Authorization: Bearer $(secret_from "$RELAY_ENV" ARBOS_RELAY_ADMIN_TOKEN)" "$RELAY_URL/admin/calls" \
    | python3 -c 'import sys, json; a = json.load(sys.stdin).get("agentd") or {}; print(a.get("real_min_sha") or a.get("fleet_min_sha") or "")' 2>/dev/null || true
}

box_quiet() {
  # no inference debits for this user in the last 5 minutes
  local now q
  now=$(date +%s%3N)
  q="$(relay_db "select count(*) from credit_ledger where user_id='$1' and kind='inference' and at > $now-300000")"
  [[ "$q" == "0" ]]
}

upgrade_box() {
  ARBOS_RELAY_ADMIN_TOKEN="$(secret_from "$RELAY_ENV" ARBOS_RELAY_ADMIN_TOKEN)" ARBOSCTL_CONFIG=/tmp/none.json \
    /usr/local/bin/arbosctl --relay "$RELAY_URL" admin upgrade-box "$1" 2>&1 | tr -d '\n' | cut -c1-200
}

roll_pass() {
  # roll_pass <target> — one pass over every pending box (real first, then test), quiet ones only.
  local target="$1" uid tier
  for tier in real test; do
    for uid in $(pending_boxes "$target" "$tier" || true); do
      if box_quiet "$uid"; then
        log "agentd: upgrading box of $uid → $target: $(upgrade_box "$uid")"
        # One at a time: give it up to 4 minutes before the next box.
        for _ in $(seq 1 24); do
          sleep 10
          admin_users | python3 -c '
import sys, json
for u in json.load(sys.stdin):
    if u["id"] == sys.argv[1]:
        m = u.get("machine") or {}
        sys.exit(0 if not (m.get("upgrade") or {}).get("in_progress") else 1)' "$uid" && break
        done
      else
        log "agentd: $uid not quiet (inference in the last 5 min), later"
      fi
    done
  done
}

roll_boxes() {
  # roll_boxes <target> — passes every 2 min for up to ROLL_WAIT_S; 0 when no box is pending.
  local target="$1" t0
  t0=$(date +%s)
  while (( $(date +%s) - t0 < ROLL_WAIT_S )); do
    if [[ -z "$(pending_boxes "$target" all || true)" ]]; then
      log "agentd: every box (real and test) is on $target"
      return 0
    fi
    roll_pass "$target"
    sleep 120
  done
  log "agentd: roll window over; still pending: $(pending_boxes "$target" all | tr '\n' ' ')"
  return 1
}

finish_roll() {
  # finish_roll <sha> <snapshot> — deployed only when the relay sees real boxes on this commit.
  local sha="$1" snapshot="$2" seen
  seen="$(real_min_sha)"
  if [[ -n "$seen" ]] && git -C "$REPO" cat-file -e "$seen^{commit}" 2>/dev/null \
     && git -C "$REPO" merge-base --is-ancestor "$sha" "$seen" 2>/dev/null \
     && [[ -z "$(pending_boxes "$snapshot" all || true)" ]]; then
    echo "$sha" > "$STATE/agentd.deployed-sha"
    rm -f "$STATE/agentd.rolling" "$QUEUE/agentd.rolling"
    event agentd "$sha" deployed "snapshot $snapshot on every box; real_min_sha $seen"
    log "agentd: deployed — real_min_sha $seen contains $sha, snapshot $snapshot everywhere"
    return 0
  fi
  printf 'sha=%s\nsnapshot=%s\nat=%s\n' "$sha" "$snapshot" "$(date -u +%s)" > "$STATE/agentd.rolling"
  log "agentd: not done yet (real_min_sha ${seen:-none}, pending: $(pending_boxes "$snapshot" all | tr '\n' ' ')); retrying every $((ROLL_RETRY_EVERY_S / 60)) min"
  return 1
}

roll_continue() {
  # roll_continue — one more pass for a roll whose window closed with boxes pending.
  need_root
  ensure_repo
  local sha snapshot
  sha="$(sed -n 's/^sha=//p' "$STATE/agentd.rolling" 2>/dev/null | head -1)"
  snapshot="$(sed -n 's/^snapshot=//p' "$STATE/agentd.rolling" 2>/dev/null | head -1)"
  [[ -n "$sha" && -n "$snapshot" ]] || exit 0
  roll_pass "$snapshot"
  sleep 60
  finish_roll "$sha" "$snapshot" || true
}

roll_image() {
  need_root
  local sha="$1" version tag t0 st waited=0 image snapshot
  ensure_repo
  sha="$(resolve "$sha")" || { log "agentd: cannot resolve $1"; exit 1; }
  version="$(next_image_version "$sha")"
  tag="image-v$version"
  t0=$(date +%s)
  rm -f "$STATE/agentd.rolling"
  log "agentd: rolling $sha as image $version"
  if [[ "$(resolve "$tag" || true)" != "$sha" ]]; then
    push_tag "$tag" "$sha"
    log "agentd: pushed tag $tag"
  fi
  while :; do
    st="$(image_run_state "$tag")"
    case "$st" in
      ok) break ;;
      failed) record_failure agentd "$sha" "image workflow for $tag failed (build or smoke); nothing rolled"; exit 1 ;;
    esac
    (( waited >= IMAGE_WAIT_S )) && { record_failure agentd "$sha" "image workflow for $tag not done after $waited s"; exit 1; }
    sleep 30; waited=$((waited + 30))
  done
  log "agentd: image $version built and smoke-tested after $(( $(date +%s) - t0 )) s"
  image="ghcr.io/$GH_REPO/arbos-agent:$version"
  snapshot="arbos-agent-$version"
  prune_snapshots "$version"
  git -C "$REPO" checkout -q --detach "$sha"
  DAYTONA_API_KEY="$(secret_from "$RELAY_ENV" DAYTONA_API_KEY)" \
    bash "$REPO/image/register-snapshot.sh" "$snapshot" "$image" 4 8 10 > "$STATE/runs/agentd-$version-register.log" 2>&1 \
    || { record_failure agentd "$sha" "snapshot registration failed: $(tail -2 "$STATE/runs/agentd-$version-register.log" | tr '\n' ' ')"; exit 1; }
  log "agentd: snapshot $snapshot active"
  if grep -q '^ARBOS_DAYTONA_SNAPSHOT=' "$RELAY_ENV"; then
    sed -i "s|^ARBOS_DAYTONA_SNAPSHOT=.*|ARBOS_DAYTONA_SNAPSHOT=$snapshot|" "$RELAY_ENV"
  else
    echo "ARBOS_DAYTONA_SNAPSHOT=$snapshot" >> "$RELAY_ENV"
  fi
  systemctl restart arbos-relay.service
  sleep 3
  curl -fsS --max-time 10 "$RELAY_URL/healthz" >/dev/null || { record_failure agentd "$sha" "relay did not come back after the snapshot switch"; exit 1; }
  log "agentd: relay default is $snapshot; rolling boxes"
  event agentd "$sha" image_registered "image $version, snapshot $snapshot is the relay default"
  # The request is served from here on; a newer request supersedes the retry cadence.
  if [[ "$(sed -n 's/^sha=//p' "$QUEUE/agentd" 2>/dev/null)" == "$sha" ]]; then rm -f "$QUEUE/agentd"; fi
  roll_boxes "$snapshot" || true
  sleep 30
  finish_roll "$sha" "$snapshot" || true
  log "agentd: image $version from $sha — $(( $(date +%s) - t0 )) s so far"
}

# ---------------------------------------------------------------------------------------------
# tick
# ---------------------------------------------------------------------------------------------

newest_green() {
  # The newest commit on main whose CI run is green (main moves while CI runs; deploy what is
  # proven, not the head of the minute). Cached per tick.
  if [[ -n "${NEWEST_GREEN:-}" ]]; then echo "$NEWEST_GREEN"; return; fi
  local sha
  for sha in $(git -C "$REPO" rev-list origin/main -n 25); do
    if [[ "$(ci_state "$sha")" == success ]]; then
      NEWEST_GREEN="$sha"
      echo "$sha"
      return
    fi
  done
  NEWEST_GREEN=""
}

auto_requests() {
  local kind head deployed enabled
  head="$(newest_green)"
  [[ -n "$head" ]] || return 0
  for kind in relay voice agentd; do
    case "$kind" in
      relay) enabled="$AUTO_DEPLOY_RELAY" ;;
      voice) enabled="$AUTO_DEPLOY_VOICE" ;;
      agentd) enabled="$AUTO_DEPLOY_AGENTD" ;;
    esac
    [[ "$enabled" == 1 ]] || continue
    deployed="$(deployed_sha "$kind")"
    [[ -n "$deployed" ]] || continue
    [[ "$deployed" == "$head" ]] && continue
    git -C "$REPO" cat-file -e "$deployed^{commit}" 2>/dev/null || continue
    [[ "$(sed -n 's/^sha=//p' "$QUEUE/$kind" 2>/dev/null)" == "$head" ]] && continue
    # shellcheck disable=SC2046
    if ! git -C "$REPO" diff --quiet "$deployed" "$head" -- $(paths_of "$kind"); then
      ARBOS_DEPLOY_QUEUE="$QUEUE" "$HOOK" "$kind" "$head" >/dev/null && log "auto: $kind differs from main in its paths; requested $head (newest green)"
    fi
  done
}

handle_request() {
  local file="$1" kind sha requested first now age_last age_first full state
  kind="$(sed -n 's/^kind=//p' "$file")"
  sha="$(sed -n 's/^sha=//p' "$file")"
  requested="$(sed -n 's/^requested_at=//p' "$file")"
  first="$(sed -n 's/^first_requested_at=//p' "$file")"
  now=$(date -u +%s)
  age_last=$(( now - ${requested:-$now} ))
  age_first=$(( now - ${first:-$now} ))
  if (( age_last < SETTLE_S && age_first < MAX_WAIT_S )); then
    return 0
  fi
  full="$(resolve "$sha" || true)"
  if [[ -z "$full" ]] || ! on_main "$full"; then
    log "$kind: request $sha is not a commit on main; dropped"
    rm -f "$file"
    return 0
  fi
  if [[ -e "$(failed_marker "$kind" "$full")" ]]; then
    local attempts at
    attempts="$(failed_attempts "$kind" "$full")"; at="$(failed_at "$kind" "$full")"
    if (( ${attempts:-0} >= 2 )); then
      log "$kind: $full failed twice; waiting for the next commit"
      event "$kind" "$full" deploy_given_up "failed twice; waiting for the next commit"
      rm -f "$file"
      return 0
    fi
    if (( now - ${at:-0} < RETRY_AFTER_S )); then
      return 0
    fi
    log "$kind: retrying $full after a failure"
  fi
  local deployed
  deployed="$(deployed_sha "$kind")"
  if [[ -n "$deployed" ]] && git -C "$REPO" cat-file -e "$deployed^{commit}" 2>/dev/null \
     && git -C "$REPO" merge-base --is-ancestor "$full" "$deployed" 2>/dev/null; then
    log "$kind: $full is already in the deployed $deployed; nothing to do"
    rm -f "$file"
    return 0
  fi
  state="$(ci_state "$full")"
  case "$state" in
    pending) log "$kind: CI for $full still running; waiting"; return 0 ;;
    failed) log "$kind: CI for $full is red; request dropped (the next green commit will be deployed)"; rm -f "$file"; return 0 ;;
    none)
      if (( $(commit_age_s "$full") < CI_NONE_GRACE_S )); then
        log "$kind: no CI run for $full yet; waiting"; return 0
      fi
      log "$kind: no CI run for $full after ${CI_NONE_GRACE_S}s; the build itself is the gate" ;;
  esac
  case "$kind" in
    relay)
      if deploy_relay "$full"; then rm -f "$file"; fi ;;
    voice)
      if deploy_voice "$full"; then rm -f "$file"; fi ;;
    agentd)
      if systemctl is-active --quiet arbos-deploy-agentd.service; then
        return 0
      fi
      if [[ "$(sed -n 's/^sha=//p' "$STATE/agentd.rolling" 2>/dev/null)" == "$full" ]]; then
        # Its image is registered and the default; only boxes are still pending (roll_continue).
        rm -f "$file"
        return 0
      fi
      systemd-run --unit=arbos-deploy-agentd --collect --quiet \
        --property=Type=oneshot --property=StandardOutput=journal \
        "$0" roll-image "$full"
      event agentd "$full" roll_started "image build + snapshot + roll started"
      log "agentd: roll of $full started (unit arbos-deploy-agentd)" ;;
  esac
}

continue_roll_if_due() {
  [[ -f "$STATE/agentd.rolling" ]] || return 0
  systemctl is-active --quiet arbos-deploy-agentd.service && return 0
  local at
  at="$(sed -n 's/^at=//p' "$STATE/agentd.rolling" | head -1)"
  (( $(date -u +%s) - ${at:-0} >= ROLL_RETRY_EVERY_S )) || return 0
  systemd-run --unit=arbos-deploy-agentd --collect --quiet \
    --property=Type=oneshot --property=StandardOutput=journal \
    "$0" roll-continue
  log "agentd: another roll pass started for $(sed -n 's/^sha=//p' "$STATE/agentd.rolling" | head -1)"
}

tick() {
  need_root
  [[ -e "$KILL_FILE" ]] && exit 0
  mkdir -p "$STATE"
  exec 9> "$STATE/.lock"
  flock -n 9 || exit 0
  ensure_repo
  mkdir -p "$QUEUE"
  auto_requests
  local f
  for f in "$QUEUE"/relay "$QUEUE"/voice "$QUEUE"/agentd; do
    [[ -f "$f" ]] && handle_request "$f"
  done
  continue_roll_if_due
  return 0
}

status() {
  echo "relay   deployed $(deployed_sha relay)"
  echo "voice   deployed $(deployed_sha voice)"
  echo "agentd  deployed $(deployed_sha agentd) (default snapshot $(secret_from "$RELAY_ENV" ARBOS_DAYTONA_SNAPSHOT 2>/dev/null || echo ?))"
  echo "main    $(resolve origin/main 2>/dev/null || echo '(no clone yet)')"
  echo "queue:"; ls -l "$QUEUE" 2>/dev/null | tail -n +2 || true
  for f in "$QUEUE"/*; do [[ -f "$f" ]] && { echo "  $(basename "$f"): $(tr '\n' ' ' < "$f")"; }; done
  echo "failed:"; for f in "$STATE"/failed/*; do [[ -f "$f" ]] && echo "  $(basename "$f"): $(tr '\n' ' ' < "$f")"; done
  echo "agentd roll unit: $(systemctl is-active arbos-deploy-agentd.service 2>/dev/null || true)"
  [[ -f "$STATE/agentd.rolling" ]] && echo "agentd roll pending: $(tr '\n' ' ' < "$STATE/agentd.rolling")"
  echo "events (last 5):"; tail -n 5 "$EVENTS" 2>/dev/null || true
  echo "last log lines:"; tail -n 15 "$LOG" 2>/dev/null || true
}

case "${1:-}" in
  tick) tick ;;
  roll-image) roll_image "${2:?sha}" ;;
  roll-continue) roll_continue ;;
  status) status ;;
  *) echo "usage: arbos-deploy-worker tick | roll-image <sha> | roll-continue | status" >&2; exit 2 ;;
esac
